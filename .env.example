DJANGO_SECRET=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Mode debug de Django (false en production)
DJANGO_DEBUG=true

# Adresses publiques (liens des e-mails, redirections OAuth)
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:8080

# E-mails de confirmation. Sans EMAIL_HOST, ils s'affichent dans les logs du backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Connexion avec Google / GitHub (facultatif, voir le README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Service Spotify (facultatif, voir le README : compte Premium et 127.0.0.1 obligatoires)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/services/spotify/callback

# Clé d'API Steam du serveur (facultatif) : « Se connecter avec Steam » suffit alors aux utilisateurs
STEAM_API_KEY=
